rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSha256Hash(hash) {
      return hash is string && hash.size() == 64 && hash.matches('^[a-f0-9]{64}$');
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'photoUrl', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoUrl', 'preferredLanguage', 'phoneHash', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.photoUrl is string && data.photoUrl.size() <= 500
        && data.preferredLanguage is string && data.preferredLanguage in ['ha', 'en']
        && (!('phoneHash' in data) || (data.phoneHash is string && (data.phoneHash == '' || isValidSha256Hash(data.phoneHash))))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDirectoryUser(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'displayNameLower', 'photoUrl', 'emailHash', 'searchable', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'displayNameLower', 'photoUrl', 'emailHash', 'searchable', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.displayNameLower is string && data.displayNameLower.size() >= 1 && data.displayNameLower.size() <= 100
        && data.photoUrl is string && data.photoUrl.size() <= 500
        && isValidSha256Hash(data.emailHash)
        && data.searchable is bool
        && data.updatedAt is timestamp;
    }

    function isValidLookupDoc(data) {
      return data.keys().hasAll(['uid', 'displayName', 'photoUrl', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.photoUrl is string && data.photoUrl.size() <= 500
        && data.updatedAt is timestamp;
    }

    function isValidParticipantPair(pair, chatId) {
      return pair is list
        && pair.size() == 2
        && pair[0] is string && isValidId(pair[0])
        && pair[1] is string && isValidId(pair[1])
        && pair[0] < pair[1]
        && chatId == (pair[0] + '_' + pair[1]);
    }

    function isValidParticipantBoolMap(m, pair) {
      return m is map
        && m.keys().hasOnly(pair)
        && (!(pair[0] in m) || m[pair[0]] is bool)
        && (!(pair[1] in m) || m[pair[1]] is bool);
    }

    function isValidParticipantIntMap(m, pair) {
      return m is map
        && m.keys().hasOnly(pair)
        && (!(pair[0] in m) || (m[pair[0]] is int && m[pair[0]] >= 0 && m[pair[0]] <= 100000))
        && (!(pair[1] in m) || (m[pair[1]] is int && m[pair[1]] >= 0 && m[pair[1]] <= 100000));
    }

    function isValidUnreadIncrement(existingData, incomingData, callerUid, peerUid) {
      return ('unreadCounts' in incomingData)
        && (
          !('unreadCounts' in existingData)
          || !(callerUid in existingData.unreadCounts)
          || !(callerUid in incomingData.unreadCounts)
          || incomingData.unreadCounts[callerUid] == existingData.unreadCounts[callerUid]
        )
        && (
          (
            (!('unreadCounts' in existingData) || !(peerUid in existingData.unreadCounts))
            && (peerUid in incomingData.unreadCounts)
            && incomingData.unreadCounts[peerUid] == 1
          )
          || (
            ('unreadCounts' in existingData)
            && (peerUid in existingData.unreadCounts)
            && (peerUid in incomingData.unreadCounts)
            && incomingData.unreadCounts[peerUid] == existingData.unreadCounts[peerUid] + 1
          )
        );
    }

    function isValidClearUnread(existingData, incomingData, callerUid, peerUid) {
      return ('unreadCounts' in incomingData)
        && (callerUid in incomingData.unreadCounts)
        && incomingData.unreadCounts[callerUid] == 0
        && (
          !('unreadCounts' in existingData)
          || !(peerUid in existingData.unreadCounts)
          || (
            (peerUid in incomingData.unreadCounts)
            && incomingData.unreadCounts[peerUid] == existingData.unreadCounts[peerUid]
          )
        );
    }

    function isValidTypingUpdate(existingData, incomingData, callerUid, peerUid) {
      return ('typingUsers' in incomingData)
        && (callerUid in incomingData.typingUsers)
        && incomingData.typingUsers[callerUid] is bool
        && (
          !('typingUsers' in existingData)
          || !(peerUid in existingData.typingUsers)
          || (
            (peerUid in incomingData.typingUsers)
            && incomingData.typingUsers[peerUid] == existingData.typingUsers[peerUid]
          )
        );
    }

    function isValidTypingClearOnSend(existingData, incomingData, callerUid, peerUid) {
      return !('typingUsers' in incomingData)
        || (
          (
            !(callerUid in incomingData.typingUsers)
            || incomingData.typingUsers[callerUid] == false
          )
          && (
            !('typingUsers' in existingData)
            || !(peerUid in existingData.typingUsers)
            || (
              (peerUid in incomingData.typingUsers)
              && incomingData.typingUsers[peerUid] == existingData.typingUsers[peerUid]
            )
          )
        );
    }

    function isValidChatThread(data, chatId) {
      return data.keys().hasAll([
          'chatId', 'participantIds', 'participantNames', 'participantPhotos',
          'lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'chatId', 'participantIds', 'participantNames', 'participantPhotos',
          'lastMessageText', 'lastMessageSenderId', 'lastMessageAt',
          'unreadCounts', 'typingUsers', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.chatId)
        && data.chatId == chatId
        && isValidParticipantPair(data.participantIds, chatId)
        && data.participantNames is map
        && data.participantNames.keys().hasAll(data.participantIds)
        && data.participantNames.keys().hasOnly(data.participantIds)
        && data.participantNames[data.participantIds[0]] is string
        && data.participantNames[data.participantIds[0]].size() >= 1
        && data.participantNames[data.participantIds[0]].size() <= 100
        && data.participantNames[data.participantIds[1]] is string
        && data.participantNames[data.participantIds[1]].size() >= 1
        && data.participantNames[data.participantIds[1]].size() <= 100
        && data.participantPhotos is map
        && data.participantPhotos.keys().hasAll(data.participantIds)
        && data.participantPhotos.keys().hasOnly(data.participantIds)
        && data.participantPhotos[data.participantIds[0]] is string
        && data.participantPhotos[data.participantIds[0]].size() <= 500
        && data.participantPhotos[data.participantIds[1]] is string
        && data.participantPhotos[data.participantIds[1]].size() <= 500
        && data.lastMessageText is string && data.lastMessageText.size() <= 2000
        && data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128
        && data.lastMessageAt is timestamp
        && (!('unreadCounts' in data) || isValidParticipantIntMap(data.unreadCounts, data.participantIds))
        && (!('typingUsers' in data) || isValidParticipantBoolMap(data.typingUsers, data.participantIds))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, chatId, messageId) {
      return data.keys().hasAll(['id', 'chatId', 'senderId', 'participantIds', 'text', 'imageBase64', 'createdAt'])
        && data.keys().hasOnly(['id', 'chatId', 'senderId', 'participantIds', 'text', 'imageBase64', 'status', 'createdAt', 'deliveredAt', 'readAt'])
        && isValidId(data.id) && data.id == messageId
        && isValidId(data.chatId) && data.chatId == chatId
        && isValidId(data.senderId)
        && isValidParticipantPair(data.participantIds, chatId)
        && data.senderId in data.participantIds
        && data.text is string && data.text.size() <= 2000
        && data.imageBase64 is string && data.imageBase64.size() <= 220000
        && (data.text.size() >= 1 || data.imageBase64.size() >= 20)
        && (!('status' in data) || (data.status is string && data.status in ['sent', 'delivered', 'read']))
        && (!('deliveredAt' in data) || data.deliveredAt is timestamp)
        && (!('readAt' in data) || data.readAt is timestamp)
        && data.createdAt is timestamp;
    }

    // --- /users/{userId} (Strict Owner-Only PII) ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'preferredLanguage', 'phoneHash', 'updatedAt']);
      allow delete: if false;
    }

    // --- /user_directory/{userId} (Public Non-PII Searchable Directory) ---
    match /user_directory/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && existing().searchable == true;
      allow list: if isSignedIn() && existing().searchable == true;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidDirectoryUser(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidDirectoryUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'displayNameLower', 'photoUrl', 'emailHash', 'searchable', 'updatedAt']);
      allow delete: if false;
    }

    // --- /email_lookup/{emailHash} (Exact Email Hash Lookup, No Listing) ---
    match /email_lookup/{emailHash} {
      allow get: if isSignedIn() && isValidSha256Hash(emailHash);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidSha256Hash(emailHash)
        && isValidLookupDoc(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidSha256Hash(emailHash)
        && existing().uid == request.auth.uid
        && isValidLookupDoc(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']);
      allow delete: if false;
    }

    // --- /phone_lookup/{phoneHash} (Exact Nigerian Phone Hash Lookup, No Listing, No Raw Phone) ---
    match /phone_lookup/{phoneHash} {
      allow get: if isSignedIn() && isValidSha256Hash(phoneHash);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidSha256Hash(phoneHash)
        && isValidLookupDoc(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidSha256Hash(phoneHash)
        && existing().uid == request.auth.uid
        && isValidLookupDoc(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']);
      allow delete: if isVerifiedUser()
        && isValidSha256Hash(phoneHash)
        && existing().uid == request.auth.uid;
    }

    // --- /chats/{chatId} (Strict 1:1 Participant-Only Chats) ---
    match /chats/{chatId} {
      allow get: if isSignedIn()
        && isValidId(chatId)
        && request.auth.uid in existing().participantIds;
      allow list: if isSignedIn()
        && request.auth.uid in existing().participantIds;
      allow create: if isVerifiedUser()
        && isValidId(chatId)
        && isValidChatThread(incoming(), chatId)
        && request.auth.uid in incoming().participantIds
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastMessageAt == request.time
        && exists(/databases/$(database)/documents/user_directory/$(incoming().participantIds[0]))
        && exists(/databases/$(database)/documents/user_directory/$(incoming().participantIds[1]));
      allow update: if isVerifiedUser()
        && isValidId(chatId)
        && isValidChatThread(incoming(), chatId)
        && request.auth.uid in existing().participantIds
        && incoming().chatId == existing().chatId
        && incoming().participantIds == existing().participantIds
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: SendMessageSummaryUpdate (also atomically increments peer unread count and clears sender typing flag)
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'lastMessageText', 'lastMessageSenderId', 'lastMessageAt',
              'unreadCounts', 'typingUsers', 'updatedAt'
            ])
            && incoming().lastMessageSenderId == request.auth.uid
            && incoming().lastMessageAt == request.time
            && (
              (
                request.auth.uid == existing().participantIds[0]
                && isValidUnreadIncrement(existing(), incoming(), existing().participantIds[0], existing().participantIds[1])
                && isValidTypingClearOnSend(existing(), incoming(), existing().participantIds[0], existing().participantIds[1])
              )
              ||
              (
                request.auth.uid == existing().participantIds[1]
                && isValidUnreadIncrement(existing(), incoming(), existing().participantIds[1], existing().participantIds[0])
                && isValidTypingClearOnSend(existing(), incoming(), existing().participantIds[1], existing().participantIds[0])
              )
            )
          )
          ||
          // Action: UpdateTypingFlag (caller can only set their own typing flag)
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['typingUsers', 'updatedAt'])
            && (
              (
                request.auth.uid == existing().participantIds[0]
                && isValidTypingUpdate(existing(), incoming(), existing().participantIds[0], existing().participantIds[1])
              )
              ||
              (
                request.auth.uid == existing().participantIds[1]
                && isValidTypingUpdate(existing(), incoming(), existing().participantIds[1], existing().participantIds[0])
              )
            )
          )
          ||
          // Action: ClearUnreadCount (caller can only reset their own unread count to 0)
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['unreadCounts', 'updatedAt'])
            && (
              (
                request.auth.uid == existing().participantIds[0]
                && isValidClearUnread(existing(), incoming(), existing().participantIds[0], existing().participantIds[1])
              )
              ||
              (
                request.auth.uid == existing().participantIds[1]
                && isValidClearUnread(existing(), incoming(), existing().participantIds[1], existing().participantIds[0])
              )
            )
          )
          ||
          // Action: SyncParticipantProfile (can only modify caller's own entry)
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['participantNames', 'participantPhotos', 'updatedAt'])
            && (
              (
                request.auth.uid == existing().participantIds[0]
                && incoming().participantNames[existing().participantIds[1]] == existing().participantNames[existing().participantIds[1]]
                && incoming().participantPhotos[existing().participantIds[1]] == existing().participantPhotos[existing().participantIds[1]]
              )
              ||
              (
                request.auth.uid == existing().participantIds[1]
                && incoming().participantNames[existing().participantIds[0]] == existing().participantNames[existing().participantIds[0]]
                && incoming().participantPhotos[existing().participantIds[0]] == existing().participantPhotos[existing().participantIds[0]]
              )
            )
          )
        );
      allow delete: if false;

      // --- /chats/{chatId}/messages/{messageId} ---
      match /messages/{messageId} {
        allow get: if isSignedIn()
          && isValidId(chatId)
          && isValidId(messageId)
          && request.auth.uid in existing().participantIds;
        allow list: if isSignedIn()
          && request.auth.uid in existing().participantIds;
        allow create: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(messageId)
          && isValidChatMessage(incoming(), chatId, messageId)
          && incoming().senderId == request.auth.uid
          && request.auth.uid in incoming().participantIds
          && ('status' in incoming())
          && incoming().status == 'sent'
          && !('deliveredAt' in incoming())
          && !('readAt' in incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && incoming().participantIds == get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow update: if isVerifiedUser()
          && isValidId(chatId)
          && isValidId(messageId)
          && isValidChatMessage(incoming(), chatId, messageId)
          && request.auth.uid in existing().participantIds
          && existing().senderId != request.auth.uid
          && incoming().id == existing().id
          && incoming().chatId == existing().chatId
          && incoming().senderId == existing().senderId
          && incoming().participantIds == existing().participantIds
          && incoming().text == existing().text
          && incoming().imageBase64 == existing().imageBase64
          && incoming().createdAt == existing().createdAt
          && (
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deliveredAt'])
              && incoming().status == 'delivered'
              && (!('status' in existing()) || existing().status == 'sent')
              && ('deliveredAt' in incoming())
              && incoming().deliveredAt == request.time
            )
            ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deliveredAt', 'readAt'])
              && incoming().status == 'read'
              && (!('status' in existing()) || existing().status in ['sent', 'delivered'])
              && ('readAt' in incoming())
              && incoming().readAt == request.time
              && (
                (!('deliveredAt' in existing()) && ('deliveredAt' in incoming()) && incoming().deliveredAt == request.time)
                || (('deliveredAt' in existing()) && incoming().deliveredAt == existing().deliveredAt)
              )
            )
          );
        allow delete: if false;
      }
    }
  }
}
