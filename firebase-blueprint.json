{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile owned by the authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "photoUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["ha", "en"],
          "minLength": 2,
          "maxLength": 2
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "photoUrl", "preferredLanguage", "createdAt", "updatedAt"]
    },
    "DirectoryUser": {
      "title": "DirectoryUser",
      "description": "Public searchable directory entry without raw email PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "displayNameLower": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "photoUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "emailHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "searchable": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "displayNameLower", "photoUrl", "emailHash", "searchable", "updatedAt"]
    },
    "EmailLookup": {
      "title": "EmailLookup",
      "description": "Exact SHA-256 email hash lookup document mapping a hashed email to a user UID and public display info.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "photoUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "photoUrl", "updatedAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "One-to-one chat thread between two authenticated users.",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantIds": {
          "type": "array",
          "description": "Sorted list of exactly 2 participant UIDs."
        },
        "participantNames": {
          "type": "object",
          "description": "Map of participant UID to display name."
        },
        "participantPhotos": {
          "type": "object",
          "description": "Map of participant UID to photo URL."
        },
        "lastMessageText": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "lastMessageSenderId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "lastMessageAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "chatId",
        "participantIds",
        "participantNames",
        "participantPhotos",
        "lastMessageText",
        "lastMessageSenderId",
        "lastMessageAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Single real-time text message inside a one-to-one chat.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chatId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantIds": {
          "type": "array",
          "description": "Sorted list of the 2 chat participant UIDs for secure list enforcement."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "chatId", "senderId", "participantIds", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles readable and writable only by the owner."
    },
    "/user_directory/{userId}": {
      "schema": { "$ref": "#/entities/DirectoryUser" },
      "description": "Public searchable user directory by displayNameLower or emailHash without exposing raw email PII."
    },
    "/email_lookup/{emailHash}": {
      "schema": { "$ref": "#/entities/EmailLookup" },
      "description": "Exact-match SHA-256 email hash lookup documents for finding users by email."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "One-to-one chat threads accessible strictly to the two participants."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Real-time text messages inside a one-to-one chat accessible strictly to its two participants."
    }
  }
}
